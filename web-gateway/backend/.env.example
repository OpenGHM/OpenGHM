# App
ENVIRONMENT=development
# Enables the X-Mock-Role header bypass for local dev only. Never set true
# on any deployment reachable from outside your machine.
ALLOW_MOCK_AUTH=true
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars

# MongoDB
MONGODB_URL=mongodb://root:rootpassword@localhost:27418/openghm?authSource=admin
MONGODB_DB_NAME=openghm

# Redis
REDIS_URL=redis://localhost:6479/0

# Object storage (Anvil/RCAC S3). The backend never talks to S3 directly —
# Slurm job scripts upload outputs from Anvil compute nodes using their own
# credentials, and datasets/outputs are served as plain public HTTPS links.
# These are just used to build those link strings.
S3_PUBLIC_BASE_URL=https://s3.anvil.rcac.purdue.edu
S3_BUCKET=openghm

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS (JSON array of origins)
CORS_ORIGINS=["http://localhost:3100"]

# Email (password reset, email verification) — see app/services/email.py
# Leave RESEND_API_KEY empty to log emails instead of sending (local dev default)
RESEND_API_KEY=
EMAIL_FROM=no-reply@openghm.org
FRONTEND_URL=http://localhost:3100

# CILogon/OIDC scaffolding — see devdocs/inbox/overview.md for the registration steps.
# Shared secret for POST /auth/sso-login (frontend -> backend handoff after
# NextAuth verifies the CILogon id_token). Must match frontend's
# INTERNAL_SERVICE_SECRET exactly. Leave empty until CILogon is configured —
# an empty value makes /auth/sso-login refuse all requests rather than
# accept an empty/guessable secret.
INTERNAL_SERVICE_SECRET=

# reCAPTCHA v2 — POST /auth/register only. Get a secret key from
# google.com/recaptcha/admin. Leave empty to skip verification (local dev
# default, so signup stays testable without a Google account).
RECAPTCHA_SECRET_KEY=

# HPC / Anvil — slurmly client
ANVIL_SSH_HOST=anvil.rcac.purdue.edu
ANVIL_SSH_PORT=22
ANVIL_SSH_USERNAME=x-myusername
# 둘 중 하나만 설정 (KEY_CONTENT가 KEY_PATH보다 우선)
ANVIL_SSH_KEY_PATH=/path/to/ssh/private_key
ANVIL_SSH_KEY_CONTENT=
ANVIL_REMOTE_BASE_DIR=/anvil/scratch/{username}/openghm
ANVIL_PARTITION=shared
ANVIL_QOS=cpu
ANVIL_ACCOUNT=myallocation
ANVIL_MAX_CONCURRENT_COMMANDS=4
ANVIL_EXECUTION_PROFILE=anvil_cpu_modules
ANVIL_CONTAINER_IMAGE=/path/to/openghm.sif

# Job defaults
JOB_DEFAULT_WALLTIME=02:00:00
JOB_DEFAULT_NODES=1
JOB_DEFAULT_NTASKS=1
JOB_STATUS_POLL_INTERVAL=10
