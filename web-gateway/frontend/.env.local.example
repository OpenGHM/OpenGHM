# Auth.js
AUTH_SECRET=dev-auth-secret-min-32-chars-change-in-prod
NEXTAUTH_URL=http://localhost:3100

# FastAPI backend (server-side only, never exposed to browser)
BACKEND_URL=http://localhost:8100

# CILogon/OIDC scaffolding (optional) — see devdocs/inbox/overview.md for how to
# register a client at cilogon.org/oauth2/register. Leaving these unset
# simply omits CILogon from the sign-in page; credentials login is
# unaffected either way.
CILOGON_CLIENT_ID=
CILOGON_CLIENT_SECRET=
# Must match backend's INTERNAL_SERVICE_SECRET exactly.
INTERNAL_SERVICE_SECRET=

# reCAPTCHA v2 (optional) — get a site key from google.com/recaptcha/admin.
# Public by design, unlike the keys above, but read on the server and handed
# to the form as a prop rather than inlined at build time (see
# app/auth/register/page.tsx). Leaving it unset just omits the captcha widget.
RECAPTCHA_SITE_KEY=

# "false" turns the Workspace off: its links are marked Coming soon and every
# /workspace address shows one page that says so (lib/features.ts). Unset is on.
# The backend reads the same variable.
WORKSPACE_ENABLED=
