{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(kubectl --context=anvil -n openghm-dev get:*)",
      "Bash(kubectl --context=anvil -n openghm-dev describe:*)",
      "Bash(kubectl --context=anvil -n openghm-dev logs:*)"
    ],
    "deny": [
      "Bash(kubectl --context=anvil -n openghm delete:*)",
      "Bash(kubectl --context=anvil -n openghm apply:*)",
      "Read(./.claude/settings.local.json)",
      "Read(./ops/k8s/prod/secrets.yml)",
      "Read(./ops/secrets/*)",
      "Read(./**/*.env)"
    ]
  }
}
