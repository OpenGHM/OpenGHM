# Local development stack — deploy/local/docker-compose.yml
#
# Copy to deploy/local/.env if you need to override anything. Compose reads a
# .env file from this directory automatically. The compose file currently
# hardcodes every value below, so an empty .env changes nothing; this file is
# here to record what the local stack actually runs, and against what.
#
# The map this follows is devdocs/reference/environments.md.

# ─── Local — started by this compose file ───────────────────────────────────
#
#   mongodb   localhost:27418   seeded from ./mongo/init-mongo.js on first boot
#   redis     localhost:6479
#   backend   localhost:8100    ../../backend bind-mounted at /app, hot reload
#
# The frontend is NOT in this compose file. `just run dev` starts it on the
# host at localhost:3100 (`npm run dev`), so Next.js hot reload works.

COMPOSE_PROJECT_NAME=openghm
MONGO_PORT=27418
REDIS_PORT=6479
BACKEND_PORT=8100
FRONTEND_PORT=3100

# ─── Shared — the same endpoint here, in dev and in prod ────────────────────
#
# Read-only and anonymous from outside CI, so there is no local substitute and
# nothing to run. Publishing to any of them needs credentials that belong in
# repository secrets, never on a laptop.
#
#   Object storage   s3.anvil.rcac.purdue.edu, bucket `openghm`
#   SIF registry     registry.openghm.org (anonymous pull)
#   Schema host      schemas.openghm.org, or the wheel's bundled copy offline

# ─── Service credentials ────────────────────────────────────────────────────
#
# Not here. The backend's own settings live in web-gateway/backend/.env (copy from
# web-gateway/backend/.env.example), and the frontend's in web-gateway/frontend/.env.local.
